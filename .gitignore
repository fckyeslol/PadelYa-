# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# MCP config (contains secrets)
.mcp.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# easycancha session tokens / scraped auth dumps (contain account JWTs — never commit)
# perfiles de navegador por cuenta (.browser-profile-1..6) tienen cookies/sesión: ignorar todo
.firecrawl/
.playwright-mcp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
